# Ollama サーバー URL（ローカル実行・既定値でOK）
OLLAMA_BASE_URL=http://localhost:11434

# Ollama モデル名（既定: gemma3:4b）
OLLAMA_MODEL=gemma3:4b

# 生成タイムアウト秒数
OLLAMA_TIMEOUT_SEC=120

# sentence-transformers のキャッシュディレクトリ（任意・指定なければ ~/.cache/）
# SENTENCE_TRANSFORMERS_HOME=D:/models/sentence-transformers

# Hugging Face のキャッシュディレクトリ（任意）
# HF_HOME=D:/models/huggingface
